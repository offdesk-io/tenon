{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Text styles for the OFFDESK theme. Each style here replaces the shared style of the same name inside that theme's CSS block, and every shared style is replaced. Archivo for everything, IBM Plex Mono for labels, captions and code, from OFFDESK's brand stylesheet (brand/AGENTS/design-md/assets/ofd-brand.css, 5 Nov 2026). Sizes, line heights and letter spacings are literal where the brand sits off Tenon's ladders, and its 800 and 900 weights are literal because Tenon's weight scale stops at 700. Two things the brand sets are left out because a text style has no part for them: the width axis (125 for display and stat values) and the capitals on mono labels. Archivo and Plex Mono load from dist/tenon-fonts-offdesk.css, which a consumer links itself.",
  "text": {
    "title": {
      "$description": "The brand's title role (ofd-title): Archivo 800, fluid 32px up to 56px, -0.01em, 1.1. Taken over the display role, whose width 125 a text style cannot carry.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.archivo}",
        "fontSize": "clamp(32px, 4.4vw, 56px)",
        "fontWeight": 800,
        "lineHeight": 1.1,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "stat": {
      "$description": "The brand's stat value (ofd-stat-value): 40px, 900, -0.02em, 1. Its width 125 is left out, since a text style cannot carry it.",
      "$type": "typography",
      "$value": {
        "fontFamily": "{typography.family.archivo}",
        "fontSize": {
          "value": 40,
          "unit": "px"
        },
        "fontWeight": 900,
        "lineHeight": 1,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "heading-1": {
      "$description": "The brand's heading-l: 32px, 800, -0.01em, 1.1.",
